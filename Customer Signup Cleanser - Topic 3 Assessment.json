    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n const x=item.json;\n const cleanedName=String(x.fullName).trim().replace(/\\s+/g,' ').toLowerCase().replace(/\\b\\p{L}/gu,c=>c.toUpperCase());\n const cleanedEmail=String(x.email).trim().toLowerCase();\n const cleanedPhone=String(x.phone ?? '').replace(/\\D/g,'');\n return {json:{...x,cleanedName,cleanedEmail,cleanedPhone}};\n});"
      },
