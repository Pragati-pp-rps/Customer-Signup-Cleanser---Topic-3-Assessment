        "jsCode": "const leads = [\n {id:'L001',fullName:'  Sarah   Connor ',email:' Sarah.Connor@Example.com ',phone:'(555) 123-4567'},\n {id:'L002',fullName:'Anna Lee',email:'ANNA.LEE@example.com',phone:'+1 (555) 222-3344'},\n {id:'L003',fullName:'',email:'missing@example.com',phone:'555-100-2000'},\n {id:'L004',fullName:'Michael Brown',email:'',phone:'555-222-1000'},\n {id:'L005',fullName:'sarah connor',email:'sarah.connor@example.com',phone:'555.123.4567'},\n {id:'L006',fullName:'  ANNA   LEE ',email:' anna.lee@EXAMPLE.com ',phone:'5552223344'},\n {id:'L007',fullName:' James   Wilson ',email:'JAMES@EXAMPLE.COM',phone:'555-888-1234'}\n];\nreturn leads.map(lead => ({json:lead}));"
      },
      "id": "e50452c4-81f9-4aa3-a4f4-2c10d25a1180",
      "name": "Mock Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
