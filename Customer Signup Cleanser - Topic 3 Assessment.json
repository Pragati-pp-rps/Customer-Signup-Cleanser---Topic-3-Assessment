        416
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n const x=item.json;\n const name=String(x.fullName ?? '').trim();\n const email=String(x.email ?? '').trim();\n const missing=[];\n if (!name) missing.push('fullName');\n if (!email) missing.push('email');\n return {json:{...x,isValid:missing.length===0,rejectionReason:missing.length ? 'Missing required fields: '+missing.join(', ') : ''}};\n});"
      },
      "id": "16bd0a6b-a29e-4169-8033-32f800fd42f1",
